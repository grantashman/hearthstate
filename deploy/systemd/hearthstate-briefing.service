[Unit]
Description=Hearthstate morning briefing delivery
After=hearthstate-dashboard.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/workspace/hearthstate
ExecStart=/usr/bin/python3 -m hearthstate.briefing_delivery --database /home/ubuntu/workspace/hearthstate/hearthstate.db --accounts-database /home/ubuntu/workspace/hearthstate/hearthstate-accounts.db --household-id home --viewer grant --briefing-type morning --agentmail
StandardOutput=null
StandardError=journal
Environment=TZ=Australia/Sydney
Nice=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
